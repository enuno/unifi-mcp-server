# UniFi API Configuration
# Obtain your API key from https://unifi.ui.com
# Navigate to: Settings → Control Plane → Integrations → Create API Key
# IMPORTANT: API key is shown only once - save it securely!

# Required: UniFi API Key
UNIFI_API_KEY=your-api-key-here

# API Type: Choose based on your UniFi API access
# - 'cloud-v1': Official stable v1 API (https://api.ui.com/v1/...)
#               Fully stable, backward compatible, long-term support
#               Rate limit: 10,000 requests/minute
# - 'cloud-ea': Early Access API (https://api.ui.com/ea/...)
#               Testing/feedback phase, may change based on user input
#               Rate limit: 100 requests/minute
# - 'local': Direct gateway access (https://{gateway-ip}/proxy/network/...)
#            Requires local network access to UniFi gateway
UNIFI_API_TYPE=cloud-v1

# Cloud API Configuration (for cloud-v1 or cloud-ea)
UNIFI_CLOUD_API_URL=https://api.ui.com

# Local API Configuration (for local mode only)
# Uncomment these lines when using UNIFI_API_TYPE=local
# UNIFI_LOCAL_HOST=192.168.2.1
# UNIFI_LOCAL_PORT=443
# UNIFI_LOCAL_VERIFY_SSL=false

# Default site ID (optional, defaults to 'default')
# UNIFI_DEFAULT_SITE=default

# MCP Server Transport Configuration
# Transport mode: stdio (default), sse, http, or streamable_http
# - stdio: stdin/stdout for local subprocess (Claude Desktop, Cursor, etc.)
# - streamable_http: Modern HTTP transport for MCP gateways and network access (recommended over sse)
# - http: Standard HTTP server for network access
# - sse: Server-Sent Events, deprecated — known client-race issue with proxies
#   like mcp-remote ("Received request before initialization was complete",
#   see issue #96); prefer streamable_http instead
MCP_SERVER_TRANSPORT=stdio
# Bind address for http/sse/streamable_http. Defaults to loopback (127.0.0.1).
# Set to 0.0.0.0 only behind an authenticating reverse proxy; exposing the
# port also requires MCP_AUTH_TOKEN (see below).
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=3000
# Bearer token required to call the server over a network transport. Clients
# send "Authorization: Bearer <token>". Comma-separate to issue several. When
# unset, only the stdio transport is allowed to start. Ignored for stdio.
# MCP_AUTH_TOKEN=change-me-to-a-long-random-string
MCP_LOG_LEVEL=INFO

# Optional: Rate Limiting
# Early Access (EA): 100 requests/minute, v1 Stable: 10,000 requests/minute
# UNIFI_RATE_LIMIT=100

# Optional: Safety
# Read-only mode. When true, tools that can change controller state are never
# registered, so they are absent from the MCP tool list entirely. Recommended
# for monitoring, reporting, and any agent that should not be able to write.
# UNIFI_READ_ONLY=false

# Optional: Advanced Settings
# UNIFI_REQUEST_TIMEOUT=30
# UNIFI_MAX_RETRIES=3
# UNIFI_RETRY_TOTAL_TIMEOUT=60
# UNIFI_PROFILE=network
# UNIFI_CONTROLLERS={"main":{"host":"192.168.2.1","site":"default"}}
# DRY_RUN=false
# UNIFI_AUDIT_LOG_PATH=./audit.log
# UNIFI_METRICS_ENABLED=false
# UNIFI_WEBHOOK_REDIS_URL=redis://:password@localhost:6379/0

# Optional: Site Manager API (cloud-ea only)
# Enables multi-site management tools when using cloud-ea API type
# UNIFI_SITE_MANAGER_ENABLED=true
# Get your Organization ID from https://app.agnost.ai
# AGNOST_ENABLED=true
# AGNOST_ORG_ID=your-organization-id-here
# AGNOST_ENDPOINT=https://api.agnost.ai
# AGNOST_DISABLE_INPUT=false
# AGNOST_DISABLE_OUTPUT=false

# Optional: Supermemory (operator notes/context storage)
# Persists operator notes and context across MCP tool calls, scoped per site.
# Get your API key at https://console.supermemory.ai
# Requires: pip install supermemory
# SUPERMEMORY_ENABLED=true
# SUPERMEMORY_API_KEY=your-supermemory-api-key-here

# Optional: MCP Toolbox Configuration
# Toolbox provides analytics and monitoring dashboard for MCP servers
# Documentation: https://docs.agnost.ai/quickstart
# TOOLBOX_VERSION=0.14.0
# TOOLBOX_PORT=8080
# TOOLBOX_SERVICE_NAME=unifi-mcp-toolbox
