{
  "name": "unifi-mcp-server",
  "description": "MCP server for managing UniFi Network, Protect, Site Manager, and A2A delegation",
  "version": "0.6.3",
  "protocol": "MCP/1.0",
  "capabilities": [
    "network-management",
    "multi-site",
    "audit-log",
    "safety-controls",
    "multi-auth"
  ],
  "authentication": {
    "schemes": [
      "bearer",
      "api-key"
    ],
    "modes": [
      "local",
      "cloud-v1",
      "cloud-ea"
    ],
    "scopes": [
      "read",
      "write",
      "destructive",
      "admin"
    ]
  },
  "tools_manifest_url": "/a2a/discover",
  "delegate_url": "/a2a/delegate",
  "audit_url": "/a2a/audit",
  "contact": {
    "url": "https://github.com/enuno/unifi-mcp-server"
  }
}
