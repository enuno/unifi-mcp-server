{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "unifi-mcp-server-skills",
  "description": "Index of the agent skills shipped by the UniFi MCP Server plugins. The skill content lives in skills/<name>/SKILL.md; this file only indexes it.",
  "sourceOfTruth": "skills/",
  "audiences": {
    "operator": "Ships in the plugin packages. Uses a running MCP server.",
    "developer": "Stays in the repository. Helps a coding agent change this codebase."
  },
  "tiers": {
    "read": "Observes controller state. Available in a read-only session.",
    "write": "Changes controller state. Refused in a read-only session.",
    "destructive": "Changes controller state in a way that can interrupt service or lock an operator out. Off unless the session allows writes.",
    "fleet": "Reads across controllers. Needs a fleet registry."
  },
  "version": "0.12.0",
  "pluginDescription": "Operate UniFi Network, UniFi Protect and the UniFi cloud APIs through the UniFi MCP Server. Ships the operator skills for network, devices, security, system, Protect, fleet and safe-change workflows.",
